<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Semestralka.WPF.AppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Správca Financií - PRO" Height="600" Width="900" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource SelectionInputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SelectionInputFgBrush}"/>
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="{DynamicResource SelectionInputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SelectionInputFgBrush}"/>
        </Style>
    </Window.Resources>
                <Grid xmlns:sys="clr-namespace:System;assembly=mscorlib">
        <!-- LOGIN GRID -->
        <Grid x:Name="LoginGrid" Background="{DynamicResource PanelBgBrush}" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                <TextBlock Text="Prihlásenie" FontSize="26" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                <TextBlock Text="Master Heslo (Pri prvom spustení len kliknite Odomknúť):" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <PasswordBox x:Name="LoginPasswordBox" Margin="0,0,0,15" Padding="5" FontSize="16" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}"/>
                <Button Content="Odomknúť aplikáciu" Background="#007ACC" Foreground="White" Padding="12" Click="Login_Click" FontWeight="Bold" FontSize="16"/>
                <TextBlock x:Name="LoginErrorText" Foreground="Red" Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- MAIN APP GRID -->
        <Grid x:Name="MainGrid" Visibility="Collapsed" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource GridBgBrush}" Padding="15" CornerRadius="5" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Aktívny účet:" FontSize="16" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                    <ComboBox x:Name="WalletsComboBox" Width="200" DisplayMemberPath="Name" Margin="0,0,15,0" FontSize="14"
                              ItemsSource="{Binding Wallets}" SelectedItem="{Binding SelectedWallet, Mode=TwoWay}"
                              Background="{DynamicResource SelectionInputBgBrush}" Foreground="{DynamicResource SelectionInputFgBrush}"/>
                            <Button Content="+ Pridať novú peňaženku" Padding="10,5" Command="{Binding ShowNewWalletCommand}" Foreground="{DynamicResource SelectionButtonFgBrush}"/>
                            <Button Content="Vymazať peňaženku" Padding="10,5" Margin="8,0,0,0" Command="{Binding DeleteWalletCommand}" Foreground="{DynamicResource SelectionButtonFgBrush}"/>

                    <TextBlock Text="Zostatok:" FontSize="16" VerticalAlignment="Center" Margin="50,0,10,0"/>
                    <TextBlock x:Name="BalanceTextBlock" Text="{Binding BalanceText}" FontSize="20" FontWeight="Bold" Foreground="{Binding BalanceForeground}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1" FontSize="14" Background="{DynamicResource CardBgBrush}">
                <TabItem Header="Transakcie">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Pridať transakciu" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <TextBlock Text="Suma (EUR):" Margin="0,0,0,5"/>
                            <TextBox x:Name="AmountTextBox" Margin="0,0,0,10" Padding="5" Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}"/>
                            <TextBlock Text="Kategória:" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CategoryComboBox" IsEditable="True" Margin="0,0,0,10" Padding="5" ItemsSource="{Binding Categories}" Text="{Binding CategoryText, Mode=TwoWay}"
                                      Background="{DynamicResource SelectionInputBgBrush}" Foreground="{DynamicResource SelectionInputFgBrush}"/>
                            <TextBlock Text="Popis:" Margin="0,0,0,5"/>
                            <TextBox x:Name="DescriptionTextBox" Margin="0,0,0,10" Padding="5" Text="{Binding DescriptionText, Mode=TwoWay}"
                                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}"/>
                            <TextBlock Text="Typ:" Margin="0,0,0,5"/>
                            <ComboBox x:Name="TypeComboBox" Margin="0,0,0,10" Padding="5" SelectedItem="{Binding SelectedType, Mode=TwoWay}" ItemsSource="{Binding TransactionTypes}"
                                      Background="{DynamicResource SelectionInputBgBrush}" Foreground="{DynamicResource SelectionInputFgBrush}"/>
                            <CheckBox x:Name="RecurringCheckBox" Content="Opakovať každý mesiac (Trvalý príkaz)" Margin="0,0,0,20" IsChecked="{Binding IsRecurring, Mode=TwoWay}"/>
                            <Button Content="Pridať do účtu" Background="#007ACC" Foreground="White" Padding="10" FontWeight="Bold" Command="{Binding AddTransactionCommand}"/>
                            <Button Content="Odstrániť označenú transakciu" Background="#D9534F" Foreground="White" Padding="10" FontWeight="Bold" Margin="0,10,0,0" Command="{Binding DeleteTransactionCommand}"/>
                        </StackPanel>
                        
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource GridBgBrush}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Filter:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Width="140" Padding="5" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"
                                             Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" />
                                    <TextBox Width="100" Padding="5" Text="{Binding FilterAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"
                                             Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" />
                                    <ComboBox Width="130" ItemsSource="{Binding FilterCategories}" SelectedItem="{Binding SelectedFilterCategory}" Margin="0,0,10,0"
                                              Background="{DynamicResource SelectionInputBgBrush}" Foreground="{DynamicResource SelectionInputFgBrush}" />
                                    <ComboBox Width="120" ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding SelectedFilterType}" Margin="0,0,10,0"
                                              Background="{DynamicResource SelectionInputBgBrush}" Foreground="{DynamicResource SelectionInputFgBrush}" />
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="TransactionsDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AlternatingRowBackground="{DynamicResource GridBgBrush}" ItemsSource="{Binding TransactionsView}" SelectedItem="{Binding SelectedTransaction, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dátum" Binding="{Binding Date, StringFormat=\{0:d\}}" Width="Auto"/>
                                <DataGridTextColumn Header="Suma" Binding="{Binding Amount, StringFormat={}{0:N2} \€}" Width="Auto"/>
                                <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="Auto"/>
                                <DataGridTextColumn Header="Kategória" Binding="{Binding Category}" Width="*"/>
                                <DataGridTextColumn Header="Popis" Binding="{Binding Description}" Width="*"/>
                                <DataGridCheckBoxColumn Header="Je Trvalý" Binding="{Binding IsRecurring}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Rozpočty">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource GridBgBrush}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Mesačný limit (€):" Margin="0,0,8,0" />
                                <TextBox Width="120" Padding="5" Text="{Binding MonthlyBudgetText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"
                                         Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" />
                                <Button Content="Uložiť" Padding="8,4" Command="{Binding SetMonthlyBudgetCommand}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding MonthlyBudgetWarning}" Foreground="{Binding MonthlyBudgetWarningBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Background="{DynamicResource GridBgBrush}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kategória:" Margin="0,0,8,0" />
                                <ComboBox Width="160" ItemsSource="{Binding Categories}" SelectedItem="{Binding BudgetCategory}" Margin="0,0,10,0"
                                          Background="{DynamicResource SelectionInputBgBrush}" Foreground="{DynamicResource SelectionInputFgBrush}" />
                                <TextBlock Text="Limit (€):" Margin="0,0,8,0" />
                                <TextBox Width="100" Padding="5" Text="{Binding BudgetAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"
                                         Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" />
                                <Button Content="Nastaviť limit" Padding="8,4" Command="{Binding SetBudgetCommand}" />
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding BudgetStatuses}" AlternatingRowBackground="{DynamicResource GridBgBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kategória" Binding="{Binding Category}" Width="*" />
                                <DataGridTextColumn Header="Limit" Binding="{Binding Budget, StringFormat={}{0:N2} €}" Width="Auto" />
                                <DataGridTextColumn Header="Minuté" Binding="{Binding Spent, StringFormat={}{0:N2} €}" Width="Auto" />
                                <DataGridTextColumn Header="Stav" Binding="{Binding StatusText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Prehľady">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource GridBgBrush}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Export Excel" Padding="8,4" Margin="0,0,8,0" Command="{Binding ExportExcelCommand}" />
                                <Button Content="Export JSON" Padding="8,4" Margin="0,0,8,0" Command="{Binding ExportJsonCommand}" />
                                <Button Content="Import Excel" Padding="8,4" Margin="0,0,8,0" Command="{Binding ImportExcelCommand}" />
                                <Button Content="Import JSON" Padding="8,4" Command="{Binding ImportJsonCommand}" />
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding MonthlySummaries}" AlternatingRowBackground="{DynamicResource GridBgBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mesiac" Binding="{Binding MonthLabel}" Width="Auto" />
                                    <DataGridTextColumn Header="Príjmy" Binding="{Binding Income, StringFormat={}{0:N2} €}" Width="*" />
                                    <DataGridTextColumn Header="Výdavky" Binding="{Binding Expense, StringFormat={}{0:N2} €}" Width="*" />
                                    <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, StringFormat={}{0:N2} €}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding OverviewStats}" Margin="10,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource GridBgBrush}" Padding="8" Margin="0,0,0,8" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Value}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </TabItem>
                
                <TabItem Header="Štatistiky (Graf)">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource GridBgBrush}" Padding="8" CornerRadius="5" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Typ grafu:" Margin="0,0,10,0" />
                                <ComboBox Width="140" ItemsSource="{Binding ChartModes}" SelectedItem="{Binding SelectedChartMode}"
                                          Background="{DynamicResource SelectionInputBgBrush}" Foreground="{DynamicResource SelectionInputFgBrush}" />
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas x:Name="PieChartCanvas" Width="200" Height="200" Margin="20"/>
                            <ItemsControl x:Name="LegendItemsControl" Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0" ItemsSource="{Binding LegendItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <Rectangle Width="15" Height="15" Fill="{Binding ColorBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </TabItem>
                
                <TabItem Header="Nastavenia">
                    <StackPanel Margin="20" Width="300" HorizontalAlignment="Left">
                        <TextBlock Text="Zmena Master hesla aplikácie" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Súčasné heslo:" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="CurrentPasswordBox" Margin="0,0,0,10" Padding="5" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}"/>

                        <TextBlock Text="Nové heslo (nechajte prázdne pre zrušenie hesla):" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,15" Padding="5" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}"/>
                        <Button Content="Uložiť zmeny hesla" Background="#5CB85C" Foreground="White" Padding="8" FontWeight="Bold" Click="SavePassword_Click"/>

                        <Separator Margin="0,20,0,20"/>
                        <TextBlock Text="Vzhľad aplikácie" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ComboBox x:Name="ThemeComboBox" Margin="0,0,0,15" Padding="5" SelectionChanged="ThemeComboBox_SelectionChanged"
                                  Background="{DynamicResource SelectionInputBgBrush}" Foreground="{DynamicResource SelectionInputFgBrush}">
                            <ComboBoxItem Content="Svetlý režim (Light)"/>
                            <ComboBoxItem Content="Tmavý režim (Dark)"/>
                        </ComboBox>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- OVERLAY PRE NOVU PENAZENKU -->
        <Grid Background="#80000000" Panel.ZIndex="100" Visibility="{Binding IsNewWalletOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
            <Border Background="{DynamicResource CardBgBrush}" Width="300" Height="150" CornerRadius="5" Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Názov novej peňaženky:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox Margin="0,0,0,15" Padding="5" Text="{Binding NewWalletName, Mode=TwoWay}" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Zrušiť" Padding="10,5" Margin="0,0,10,0" Command="{Binding CancelNewWalletCommand}"/>
                        <Button Content="Vytvoriť" Background="#007ACC" Foreground="White" Padding="10,5" Command="{Binding ConfirmNewWalletCommand}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>


