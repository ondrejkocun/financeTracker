<Application x:Class="Semestralka.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Semestralka.WPF"
             StartupUri="AppWindow.xaml">
    <Application.Resources>
        <!-- Theme brushes (switched at runtime) -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="White"/>
        <SolidColorBrush x:Key="TextBrush" Color="Black"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#F0F8FF"/>
        <SolidColorBrush x:Key="GridBgBrush" Color="#E8F4F8"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="White"/>

        <!-- Global text styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- Controls adapt to theme: TextBoxes, ComboBoxes, PasswordBoxes -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridBgBrush}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridBgBrush}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridBgBrush}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <!-- Default button text should follow TextBrush unless explicit Foreground is set -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- DataGrid styling to match theme -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridBgBrush}"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource GridBgBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Application.Resources>
</Application>

